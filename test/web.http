
#Mostrar todas las webs
GET http://localhost:3000/api/web HTTP/1.1

###
#Peticion por id
GET http://localhost:3000/api/web/6717c14ac21af0b9a27b52ca HTTP/1.1
###
#Crear un nueva web
POST http://localhost:3000/api/web HTTP/1.1
Content-Type: application/json

{
  "city": "Lima",
  "activity": "Turismo",
  "tittle": "Explorando Lima",
  "sumary": "Una guía rápida para conocer Lima",
  "text": ["Texto del artículo sobre Lima"],
  "img": [],
  "user_review": {
    "scoring": 4,
    "score": 5,
    "reviews": "Muy buen artículo"
  }
}


###
#Actualizar datos de una web
PUT http://localhost:3000/api/web/6717c14ac21af0b9a27b52ca HTTP/1.1
Content-Type: application/json

{
  "city": "Cerru",
  "activity": "Turismo",
  "tittle": "Explorando Lima",
  "sumary": "Una guía rápida para conocer Lima",
  "text": ["Texto del artículo sobre Lima"],
  "img": [],
  "user_review": {
    "scoring": 4,
    "score": 5,
    "reviews": "Muy buen artículo"
  }
}

###
PATCH http://localhost:3000/api/web/6717c14ac21af0b9a27b52ca
Content-Type: multipart/form-data; boundary=Boundry

--Boundry
Content-Disposition: form-data; name="image"; filename="img.jpg"
Content-Type: image/jpg

< ./amogus.jpg
--Boundry--
###
#Borrado fisico
DELETE http://localhost:3000/api/web/6717c14ac21af0b9a27b52ca

###
#Borrado logico
DELETE http://localhost:3000/api/web/archive/6717c14ac21af0b9a27b52ca
